# логин/пароль на ЧТЕНИЕ: дашборд и vmui (https://panel.ulya.space/node-stats/...), на нодах не нужен
VM_USER=node
# только [a-z0-9]: пароль кладётся в конфиг в кавычках. Сгенерировать: openssl rand -hex 24
VM_PASS=
# пароль на ЗАПИСЬ для нод (логин writer, порт 9443): openssl rand -hex 24
VM_WRITE_PASS=
# base64 от "VM_USER:VM_PASS" — с ним шлюз ходит в VictoriaMetrics: printf '%s:%s' "$VM_USER" "$VM_PASS" | base64 -w0
VM_BACKEND_AUTH=
