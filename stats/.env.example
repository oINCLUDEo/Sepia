# логин/пароль на ЧТЕНИЕ: дашборд и vmui (https://panel.ulya.space/node-stats/...), проверяет Caddy
# (basic_auth с хешем этого пароля в Caddyfile). Нодам не нужен. Сгенерировать: openssl rand -hex 24
VM_USER=node
VM_PASS=
# пароль на ЗАПИСЬ для нод (логин writer, порт 9443): openssl rand -hex 24
VM_WRITE_PASS=
# ключ подписи cookie входа в дашборд (node-auth): openssl rand -hex 32. Сменить — разлогинить все устройства
AUTH_SECRET=
# ключ на опасные действия VictoriaMetrics (удаление, снимки, служебные страницы): openssl rand -hex 24.
# Нужен только rename-node.py; дашборду и нодам не выдаётся
VM_ADMIN_KEY=
# API-токен Remnawave для кнопки «Выключить хосты» у заблокированной ноды (пусто — кнопка не работает).
# Можно тот же, что у rw-sync.py (/etc/rw-node-sync.conf). RW_API — если контейнер панели называется не remnawave
RW_TOKEN=
# Пользователи → Тарифы: тариф узнаётся по лимитам — id:цена:ГБ:устройств через запятую (0 ГБ — безлимит, цена 0 — пробная)
#TARIFFS=trial:0:5:5,99:99:20:1,149:149:50:2,199:199:0:2,299:299:0:5
#EXTRA_DEVICE=100          # ₽ за устройство сверх лимита у самого дорогого безлимита
#TRIAL_DAYS=5
# служебные и тестовые аккаунты не считаются: имя, тег или описание совпали с регулярным выражением (по умолчанию
# test|тест|system|служеб|admin|bridge|мост|probe|monitor|internal|demo) или подписка дольше USERS_SKIP_DAYS дней вперёд
#USERS_SKIP=
#USERS_SKIP_DAYS=400
# RW_API=http://remnawave:3000/api
# Пароль администратора: автонастройка новых нод по SSH из дашборда (даёт root на новых серверах — сделайте длинным,
# не таким, как пароль входа). Пусто — кнопка «Настроить автоматически» выключена. openssl rand -base64 18
ADMIN_PASS=


# Пробник для «Рынка» — отдельный сервер: bash probe/setup.sh IP_ПАНЕЛИ на нём печатает эти три строки.
# Через него качаются подписки конкурентов, пробиваются их выходы за мостами и проверяется доступность.
PROBE_URL=
PROBE_TOKEN=
PROBE_FP=
